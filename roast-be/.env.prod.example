# Prod env template for the EC2 deploy (docs/DEPLOY_EC2.md). Copy to
# .env.prod on the instance itself (never commit the real file — it's
# already covered by .gitignore's .env* pattern) and fill in every
# <CHANGE ME>. See .env.example for the full commented list of every
# variable this app reads — this file only lists what differs from (or
# is most important to set for) a real deploy.

# --- Required, no safe default -----------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<CHANGE ME>

# The sslip.io (or real domain) hostname Caddy requests a cert for and
# Django accepts requests for. Must match SITE_ADDRESS below exactly.
# e.g. if your Elastic IP is 3.15.22.10, use 3-15-22-10.sslip.io
# Keep localhost,127.0.0.1 in the list — the `web` service's Docker
# HEALTHCHECK and scripts/deploy.sh's readiness probe both curl
# http://localhost:8000/api/v1/health/ready/ from inside the container;
# without these, every probe 400s with DisallowedHost and `web` never
# reports healthy even though it's actually up.
DJANGO_ALLOWED_HOSTS=<CHANGE ME e.g. 3-15-22-10.sslip.io>,localhost,127.0.0.1

POSTGRES_DB=roast_anything
POSTGRES_USER=roast
POSTGRES_PASSWORD=<CHANGE ME — generate a real random password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Internal Docker-network hostnames — correct as-is, matches the `redis`
# service name in docker-compose.prod.yml. Do not point these at a host
# port; nothing outside the compose network needs to reach Redis.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DJANGO_CACHE_URL=redis://redis:6379/2

STORAGE_BACKEND=cloudinary
MEDIA_ROOT=/app/media

# Required only if STORAGE_BACKEND=cloudinary (set above). Get these from
# your Cloudinary dashboard. Resumes are stored as private ("authenticated")
# raw resources — never publicly deliverable; downloads still proxy through
# this API exactly as with the local backend.
CLOUDINARY_CLOUD_NAME=<CHANGE ME>
CLOUDINARY_API_KEY=<CHANGE ME>
CLOUDINARY_API_SECRET=<CHANGE ME>
CLOUDINARY_HTTP_TIMEOUT_SECONDS=10

# Real roast generation needs this; AI_PROVIDER=stub (the dev default)
# always fails on purpose. Get a key from platform.openai.com.
AI_PROVIDER=openai
OPENAI_API_KEY=<CHANGE ME>

# --- Frontend origin (Vercel) --------------------------------------------
# Both must point at your actual Vercel deployment URL, not localhost.
# CORS_ALLOWED_ORIGINS gates which browser origins may call this API at
# all; FRONTEND_SHARE_BASE_URL is used to build the public share_url
# returned by apps.sharing (f"{FRONTEND_SHARE_BASE_URL}/r/{token}").
CORS_ALLOWED_ORIGINS=<CHANGE ME e.g. https://your-app.vercel.app>
CORS_ALLOW_CREDENTIALS=False
FRONTEND_SHARE_BASE_URL=<CHANGE ME e.g. https://your-app.vercel.app>

# --- Transactional email (Resend) ----------------------------------------
# DEFAULT_FROM_EMAIL's domain must be verified in the Resend dashboard
# (https://resend.com/domains) before sends will work.
RESEND_API_KEY=<CHANGE ME e.g. re_xxx>
DEFAULT_FROM_EMAIL=<CHANGE ME e.g. noreply@your-domain.com>

# --- Caddy (docker-compose.ec2.yml) --------------------------------------
# Must be the same hostname as DJANGO_ALLOWED_HOSTS above.
SITE_ADDRESS=<CHANGE ME e.g. 3-15-22-10.sslip.io>

# --- Worth reviewing before real traffic ---------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
ROAST_WEEKLY_QUOTA=3
ROAST_QUOTA_WINDOW_DAYS=7
THROTTLE_DEFAULT_USER=300/hour
THROTTLE_DEFAULT_ANON=60/hour
THROTTLE_SUBMISSION_CREATE=20/hour
THROTTLE_ROAST_CREATE=10/hour
THROTTLE_SHARE_LINK_CREATE=20/hour
THROTTLE_SHARE_PUBLIC_VIEW=120/hour
THROTTLE_SHARE_PUBLIC_REACT=30/hour

# Everything below has a sensible default already (see .env.example) —
# only listed here as a reminder they exist. Uncomment to override.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# MAX_UPLOAD_SIZE_BYTES=10485760
# MAX_JSON_BODY_SIZE_BYTES=1048576
# EXTRACTION_GITHUB_ACCESS_TOKEN=
# ROAST_STUCK_THRESHOLD_MINUTES=15
# EXTRACTION_STUCK_THRESHOLD_MINUTES=15
