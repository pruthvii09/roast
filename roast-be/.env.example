DJANGO_SETTINGS_MODULE=config.settings.dev
# config.settings.prod requires this be set to a real, random value — it
# will refuse to start otherwise (no insecure fallback in prod, unlike
# dev/test). Generate one with e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO

# Only read in config.settings.prod; ignored by dev/test.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=604800
# Only needed if the Django admin is exposed behind a reverse proxy on a
# host not already covered by DJANGO_ALLOWED_HOSTS's scheme matching.
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=roast_anything
POSTGRES_USER=roast
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Django's cache (DRF throttle counters) — a separate Redis DB index from
# the broker/result-backend above, so keys never collide.
DJANGO_CACHE_URL=redis://redis:6379/2

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_BYTES=10485760
# Separate, much smaller cap for non-file request bodies (JSON/form POST
# fields) — file uploads are governed by MAX_UPLOAD_SIZE_BYTES above, not
# this setting.
MAX_JSON_BODY_SIZE_BYTES=1048576

# Baseline rate limits applied to any endpoint that doesn't set its own
# tighter scope (see README.md's "Production readiness" section).
THROTTLE_DEFAULT_USER=300/hour
THROTTLE_DEFAULT_ANON=60/hour
THROTTLE_SUBMISSION_CREATE=20/hour
THROTTLE_ROAST_CREATE=10/hour
THROTTLE_SHARE_LINK_CREATE=20/hour
THROTTLE_SHARE_PUBLIC_VIEW=120/hour
THROTTLE_SHARE_PUBLIC_REACT=30/hour

# How long a single "is at least one Celery worker alive" check may take
# before GET /api/v1/health/ready/ gives up and reports celery: false.
HEALTH_CHECK_CELERY_TIMEOUT_SECONDS=1.5

# Timeout protection for the async document extraction pipeline
# (apps.extraction) — see config/settings/base.py for details.
EXTRACTION_TASK_SOFT_TIME_LIMIT_SECONDS=25
EXTRACTION_TASK_TIME_LIMIT_SECONDS=35

# Outbound HTTP limits shared by WebsiteProcessor/GitHubProcessor, and the
# normalized-text cap applied to their stored output.
EXTRACTION_HTTP_TIMEOUT_SECONDS=10
EXTRACTION_HTTP_MAX_RESPONSE_BYTES=1000000
EXTRACTION_MAX_TEXT_CHARS=20000

# GitHubProcessor. Leave EXTRACTION_GITHUB_ACCESS_TOKEN unset for
# anonymous GitHub API calls (~60 requests/hour/IP rate limit); set it to
# raise that limit. No OAuth flow exists yet — this is a single shared
# token, not per-user.
EXTRACTION_GITHUB_API_BASE_URL=https://api.github.com
EXTRACTION_GITHUB_ACCESS_TOKEN=

# AI_PROVIDER=stub (default) never calls a real vendor — safe for
# dev/CI without a key. Set AI_PROVIDER=openai + OPENAI_API_KEY to use
# the real OpenAI-backed roast generation.
AI_PROVIDER=stub
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_TEMPERATURE=0.9
AI_OPENAI_MAX_OUTPUT_TOKENS=2000
AI_OPENAI_INPUT_PRICE_PER_1K=0.00015
AI_OPENAI_OUTPUT_PRICE_PER_1K=0.0006
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_BASE_SECONDS=2
AI_MAX_SOURCE_TEXT_CHARS=8000
ROAST_ENGINE_VERSION=v1

# Weekly per-user roast quota — see the "Weekly roast quota" section in
# README.md. Every roast-creation attempt counts, including failed ones,
# in a rolling (not calendar) window.
ROAST_WEEKLY_QUOTA=3
ROAST_QUOTA_WINDOW_DAYS=7

# Timeout protection for a single process_roast_run execution (mirrors
# EXTRACTION_TASK_*_TIME_LIMIT_SECONDS above).
ROAST_TASK_SOFT_TIME_LIMIT_SECONDS=90
ROAST_TASK_TIME_LIMIT_SECONDS=120

# Staleness thresholds for the Beat reconciliation sweeps
# (apps.roasts.tasks.reconcile_stuck_roast_runs,
# apps.extraction.tasks.reconcile_stuck_extraction_tasks) — comfortably
# above each task's own time limit above.
ROAST_STUCK_THRESHOLD_MINUTES=15
EXTRACTION_STUCK_THRESHOLD_MINUTES=15

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=False

# Base URL of the frontend — used to build the public share_url returned
# by apps.sharing (f"{FRONTEND_SHARE_BASE_URL}/r/{token}").
FRONTEND_SHARE_BASE_URL=http://localhost:3000

# Host-side port overrides for docker-compose (db/redis), only needed if
# 5432/6379 are already taken by something else on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
